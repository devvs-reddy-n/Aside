{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main (Create/Connect) and overlay (Live overlay) windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "fs:allow-write-text-file"
  ]
}
