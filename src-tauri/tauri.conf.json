{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aside",
  "version": "0.1.0",
  "identifier": "com.aside.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aside",
        "url": "index.html",
        "width": 1000,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 1600,
        "maxHeight": 1040,
        "visible": true,
        "transparent": false,
        "backgroundColor": "#0b0c0c",
        "decorations": true,
        "contentProtected": true,
        "skipTaskbar": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        },
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ]
  }
}
